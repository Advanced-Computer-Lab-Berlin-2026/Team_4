# ---- Copy to server/.env and fill in. NEVER commit server/.env ----
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (see README "Database setup")
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shareshed?retryWrites=true&w=majority

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Where the React app runs (CORS + cookies)
CLIENT_URL=http://localhost:5173

# Email (OTP, Sprint 2 notifications). Leave SMTP_HOST empty in dev -> emails are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShareShed <no-reply@shareshed.local>"

# Uploads
MAX_UPLOAD_MB=5

# OTP
OTP_EXPIRY_MINUTES=10

# Sprint 2 (Stripe test mode) - leave blank for now
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
